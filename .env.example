# URL pubblica del backend ECCOMI HUB su Render, senza percorso finale.
HUB_API_BASE_URL=https://eccomi-hub-api.onrender.com

# Lettura server-side dei soli KPI Eccomi Posta. La chiave resta nell'ambiente
# protetto di ECCOMI HUB e non viene mai inviata al browser.
POSTA_SUPABASE_URL=https://your-posta-project.supabase.co
POSTA_SUPABASE_SERVICE_KEY=your-posta-service-key
# Alternativa per la configurazione protetta effettuata dal CEO dentro l'HUB.
# Serve a cifrare la credenziale prima del salvataggio nell'archivio dell'HUB.
POSTA_CONFIG_ENCRYPTION_KEY=64-character-hex-key

# KPI aggregati di Eccomi Noleggio. Il segreto è condiviso esclusivamente tra
# i due worker e non viene mai inviato al browser.
NOLEGGIO_API_URL=https://your-eccomi-noleggio-site.example
NOLEGGIO_HUB_READ_SECRET=your-long-random-secret

# Collegamento OTP diretto usato dal prototipo privato quando il backend
# separato non è ancora configurato. Impostare questi valori nell'ambiente
# di hosting, mai nei file versionati.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Analisi strategica. Se assente, ECCOMI HUB usa il proprio motore preliminare
# e mantiene comunque operativo punteggio, semaforo e decisioni CEO.
OPENAI_API_KEY=sk-your-project-key
OPENAI_MODEL=gpt-5.6
