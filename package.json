{
  "name": "eccomi-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:auth": "npm run build && node scripts/test-sites-auth-worker.mjs",
    "check:os": "node scripts/check-os-registry.mjs",
    "check:executive": "node scripts/check-executive-home.mjs",
    "verify": "npm run check:os && npm run check:executive && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "^5.7.2",
    "vite": "8.1.5"
  }
}
